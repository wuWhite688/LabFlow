# Copy to .env and adjust values. Do NOT commit real secrets.
# cp .env.example .env

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=labflow_root_change_me
MYSQL_DATABASE=labops
MYSQL_USER=labops
MYSQL_PASSWORD=labflow_mysql_change_me
MYSQL_PORT=3306

# Spring datasource (production profile)
DB_URL=jdbc:mysql://127.0.0.1:3306/labops?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=labops
DB_PASSWORD=labflow_mysql_change_me

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=labflow_redis_change_me

# ---- RabbitMQ ----
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=labops
RABBITMQ_PASSWORD=labflow_rabbit_change_me

# ---- App runtime ----
SERVER_PORT=18080
# Production defaults: no demo accounts. Enable only for local stack verification:
# LABOPS_DEMO_USERS=true
# LABOPS_DEMO_DATA=true
# scripts/verify-production.ps1 turns these on for that process only.
LABOPS_DEMO_USERS=false
LABOPS_DEMO_DATA=false

# Optional image overrides (useful behind slow Docker Hub / custom mirrors)
# MYSQL_IMAGE=mysql:8.4
# REDIS_IMAGE=redis:7.4-alpine
# RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine

# ---- JWT (REQUIRED for production profile) ----
# Generate a unique secret, e.g.:
#   openssl rand -base64 48
# Must be >= 32 bytes and MUST NOT be a placeholder (change-me / REPLACE_ME / example).
# Leaving this as REPLACE_ME_* will cause production startup to fail by design.
JWT_SECRET=REPLACE_ME_with_openssl_rand_hex_32_or_longer_secret
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# Keep true behind HTTPS. The local HTTP verification script overrides it to false.
JWT_REFRESH_COOKIE_SECURE=true
