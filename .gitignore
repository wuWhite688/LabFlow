### VS Code ###
.vscode/

# local full-stack runtime files
.runtime/
.playwright-cli/
*.pid
*.stdout.log
*.stderr.log

# 上面三条针对的是本地跑服务产生的运行时日志。benchmark/ 下的日志性质不同：
# 它不是运行时垃圾，而是压测数字的原始证据，RESULTS.md 里逐条引用了这些路径。
# 若被一起忽略，提交后报告里的"原始日志"会全部指向不存在的文件，
# 而本机因为文件还在，看起来一切正常。
!benchmark/**/*.stdout.log
!benchmark/**/*.stderr.log
# 压测运行期的 PID 与进程标记仍然不提交
benchmark/.run/
# Isolated reruns. The published snapshot stays in benchmark/results and
# benchmark/logs; a new run-all.ps1 invocation must not mix into it.
benchmark/runs/
__pycache__/
*.pyc

# local secrets and docker runtime artifacts
.env
.verify-logs/
docker-data/

# frontend build and runtime artifacts
frontend/node_modules/
frontend/dist/
frontend/.vinext/
frontend/.next/
frontend/.wrangler/

# local H2 database files
*.mv.db
*.trace.db
